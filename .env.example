# ---------------------------------------------------------------------------
# WebPilot configuration (copy to .env)
# Every value has a safe default — see packages/shared/src/config.ts
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API server -------------------------------------------------------------
WEBPILOT_PORT=8787
WEBPILOT_HOST=127.0.0.1
WEBPILOT_CORS_ORIGIN=http://localhost:3000

# --- Storage ----------------------------------------------------------------
WEBPILOT_DATA_DIR=./data
WEBPILOT_DOWNLOADS_DIR=./data/downloads
WEBPILOT_SCREENSHOTS_DIR=./data/screenshots
WEBPILOT_SESSIONS_DIR=./data/sessions
WEBPILOT_MODELS_DIR=./models
WEBPILOT_DB_URL=./data/webpilot.db

# --- Browser ----------------------------------------------------------------
WEBPILOT_BROWSER=chromium
WEBPILOT_HEADLESS=true
WEBPILOT_NAV_TIMEOUT_MS=30000
WEBPILOT_ACTION_TIMEOUT_MS=10000
WEBPILOT_MAX_BROWSER_TABS=3
WEBPILOT_BROWSER_CONTEXT_NAME=WebPilot Browser Context

# --- Resource limits --------------------------------------------------------
WEBPILOT_MAX_AGENT_STEPS=30
WEBPILOT_MAX_DOWNLOADS=100
WEBPILOT_MAX_FILE_SIZE_MB=25
WEBPILOT_MAX_TASK_TIME_MS=600000

# --- Local AI ---------------------------------------------------------------
WEBPILOT_AI_ENABLED=true
WEBPILOT_AI_MODEL_ID=onnx-community/Qwen2.5-0.5B-Instruct
WEBPILOT_AI_QUANTIZATION=q4
WEBPILOT_AI_MAX_NEW_TOKENS=512
WEBPILOT_EMBEDDING_MODEL_ID=Xenova/all-MiniLM-L6-v2

# --- Safety -----------------------------------------------------------------
# Comma separated list. When empty, downloads are allowed from any host.
WEBPILOT_DOWNLOAD_ALLOWLIST=
WEBPILOT_REQUIRE_DOWNLOAD_CONFIRMATION=false
WEBPILOT_LOG_LEVEL=info
